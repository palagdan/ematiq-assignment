# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# --- Real email (password reset links). Leave unset to use the local Mailpit inbox. ---
# Gmail (needs 2-step verification + an App Password):
# LUNCH_SMTP_HOST=smtp.gmail.com
# LUNCH_SMTP_PORT=587
# LUNCH_SMTP_SECURITY=starttls
# LUNCH_SMTP_USERNAME=you@gmail.com
# LUNCH_SMTP_PASSWORD=your-16-char-app-password
# LUNCH_MAIL_FROM=Lunch Roulette <you@gmail.com>

# Pin the origin used in emailed links (recommended outside local development):
# LUNCH_PUBLIC_URL=https://your-public-host

# --- Google sign-in ---
# LUNCH_GOOGLE_CLIENT_ID=
# LUNCH_GOOGLE_CLIENT_SECRET=

# LUNCH_SECRET_KEY=change-me
